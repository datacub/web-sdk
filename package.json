{
  "name": "@datacub/web",
  "version": "0.4.0",
  "description": "datacub product analytics for websites. One line to install, private by default.",
  "keywords": [
    "analytics",
    "product-analytics",
    "web-analytics",
    "datacub",
    "arabic"
  ],
  "homepage": "https://datacub.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacub/web-sdk.git"
  },
  "bugs": "https://github.com/datacub/web-sdk/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/datacub.mjs"
    },
    "./flags": {
      "types": "./types/flags-npm.d.ts",
      "default": "./dist/flags.mjs"
    },
    "./feedback": {
      "types": "./types/feedback.d.ts",
      "default": "./dist/feedback.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:browser": "playwright test",
    "pack:check": "bun scripts/pack-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tanstack/react-router": "1.170.46",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "author": "datacub (https://datacub.to)"
}
