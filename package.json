{
  "name": "@datacub/web",
  "version": "0.4.0",
  "description": "The official datacub SDK for websites: product analytics with automatic capture, identity and consent, in one small script.",
  "keywords": [
    "analytics",
    "product-analytics",
    "web-analytics",
    "tracking",
    "events",
    "sdk",
    "privacy",
    "consent",
    "datacub",
    "arabic",
    "rtl"
  ],
  "homepage": "https://datacub.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacub/web-sdk.git"
  },
  "bugs": "https://github.com/datacub/web-sdk/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/datacub.mjs"
    },
    "./flags": {
      "types": "./types/flags-npm.d.ts",
      "default": "./dist/flags.mjs"
    },
    "./feedback": {
      "types": "./types/feedback.d.ts",
      "default": "./dist/feedback.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:browser": "playwright test",
    "pack:check": "bun scripts/pack-check.ts",
    "version": "changeset version && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@tanstack/react-router": "1.170.46",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "author": "datacub (https://datacub.to)"
}
